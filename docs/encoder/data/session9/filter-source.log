cmplx mfsk::mixer(cmplx in, double f)
{
	cmplx z;

// Basetone is a nominal 1000 Hz
	f -= tonespacing * basetone + bandwidth / 2;

	z = in * cmplx( cos(phaseacc), sin(phaseacc) );

	phaseacc -= TWOPI * f / samplerate;
	if (phaseacc < 0) phaseacc += TWOPI;

	return z;
}

