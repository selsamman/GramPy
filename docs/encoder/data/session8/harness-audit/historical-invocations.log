grep -q '"status": "qualified"' "$qualification"; started=$(date -u +%Y-%m-%dT%H:%M:%SZ); export PATH="$build/install/bin:$PATH"
run_mapped() {
 id=$1 stem=$2 expected=$3 min_images=$4
 source_dir="/var/lib/radiogram/reference-captures/output/$stem"; out="$state/transmissions/$id"; install -d -m 0755 "$out"
 if [ -f "$out/done.sha256" ] && sha256sum -c "$out/done.sha256" >/dev/null 2>&1; then return; fi
 wav="$source_dir/$stem.wav"; raw="$source_dir/$stem.sigmf-meta"; map="$source_dir/$stem.iqprep.sigmf-meta"
 test -s "$wav"; test -s "$raw"; test -s "$map"; sha256sum "$wav" "$raw" "$map" >"$out/source.sha256"
 "$tools/fldigi-decode-wav" --input "$wav" --output "$out/decode.tar" --mode MFSK32 --rxid off --afc off \
  --audio-frequency-hz 1500 --debug-bundle full --nice 0 --post-playback-sec 15 \
  --audio-backend alsa-loopback --alsa-capture-plugin plug --mode-map-meta "$map" \
  >"$out/adapter.stdout" 2>"$out/adapter.stderr"
 test -s "$out/decode.tar"; tar -tf "$out/decode.tar" >"$out/tar-list.txt"
 tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT INT TERM; tar -xf "$out/decode.tar" -C "$tmp"
 grep -Fq "$expected" "$tmp/decoded.txt"
 python3 - "$tmp/metadata.json" "$min_images" "$map" <<'PY'
import json,sys
d=json.load(open(sys.argv[1],encoding='utf-8'))
assert d['control_exit_status']==0 and d['rxid']=='off', d
assert d['image_count']>=int(sys.argv[2]), d
assert d['audio_frequency_hz']==1500 and d['mode_map_meta']==sys.argv[3], d
PY
 ! grep -q 'ConnectionRefusedError' "$tmp/fldigi/control.log"
 grep -q 'mapped mode switch' "$tmp/fldigi/control.log"
 rm -rf "$tmp"; trap - EXIT INT TERM; sha256sum "$out/decode.tar" >"$out/done.sha256"
}
