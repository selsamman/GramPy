#!/bin/sh
set -eu
root=/opt/radiogram/reference/session10d
build="$root/builds/fldigi-4.2.13-pi3-aarch64"
qualification="$root/qualification/fldigi-4.2.13-pi3-aarch64-q2/result.json"
