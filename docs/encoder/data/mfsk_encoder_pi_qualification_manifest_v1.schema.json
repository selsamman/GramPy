{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grampy.local/schemas/mfsk-encoder-pi-qualification-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "source",
    "target",
    "receiver",
    "execution",
    "cases",
    "summary"
  ],
  "properties": {
    "schema": {"const": "grampy-mfsk-encoder-pi-qualification-manifest.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "status": {"enum": ["complete", "partial", "failed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_revision", "matrix", "encoder_distribution", "inputs"],
      "properties": {
        "repository_revision": {"$ref": "#/$defs/git_revision"},
        "matrix": {"$ref": "#/$defs/artifact"},
        "encoder_distribution": {"$ref": "#/$defs/artifact"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "platform", "architecture", "python_version"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "version", "binary", "configuration"],
      "properties": {
        "reference_id": {"const": "fldigi-4.2.13-pi3-aarch64-7fa6ee2e4178"},
        "version": {"type": "string", "minLength": 1},
        "binary": {"$ref": "#/$defs/artifact"},
        "configuration": {"type": "object"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "started_utc", "completed_utc", "log"],
      "properties": {
        "workflow": {"type": "string", "pattern": "^tools/pi-[a-z0-9-]+\\.sh$"},
        "started_utc": {"type": "string", "format": "date-time"},
        "completed_utc": {"type": "string", "format": "date-time"},
        "log": {"$ref": "#/$defs/artifact"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/case"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "blocked"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0}
      }
    },
    "wav_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "frame_count"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 44},
        "sample_rate_hz": {"const": 48000},
        "channels": {"const": 1},
        "sample_width_bytes": {"const": 2},
        "frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "encoder_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "output_path", "duration_seconds", "segments"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "output_path": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_index", "start_frame", "content_start_frames"],
            "properties": {
              "input_index": {"type": "integer", "minimum": 0},
              "start_frame": {"type": "integer", "minimum": 0},
              "content_start_frames": {
                "type": "array",
                "items": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "recovered_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "width", "height", "color", "pixel_sha256"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "color": {"enum": ["grayscale", "color"]},
        "pixel_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receiver_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "input_interval",
        "configuration",
        "exit_code",
        "log",
        "recovered_text",
        "recovered_images"
      ],
      "properties": {
        "mode": {"enum": ["MFSK32", "MFSK64"]},
        "input_interval": {"$ref": "#/$defs/interval"},
        "configuration": {"type": "object"},
        "exit_code": {"type": "integer"},
        "log": {"$ref": "#/$defs/artifact"},
        "recovered_text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "decoded_utf8"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifact"},
            "decoded_utf8": {"type": "string"}
          }
        },
        "recovered_images": {
          "type": "array",
          "items": {"$ref": "#/$defs/recovered_image"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "expected", "observed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "blocked"]},
        "expected": {},
        "observed": {},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "discrepancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "summary", "evidence"],
      "properties": {
        "classification": {
          "enum": [
            "encoder-defect",
            "reference-limitation",
            "automation-failure",
            "environment-failure",
            "unresolved"
          ]
        },
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "generated_wav",
        "encoder_result",
        "receiver_runs",
        "checks",
        "discrepancies"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "blocked"]},
        "generated_wav": {"$ref": "#/$defs/wav_artifact"},
        "encoder_result": {"$ref": "#/$defs/encoder_result"},
        "receiver_runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receiver_run"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "discrepancies": {"type": "array", "items": {"$ref": "#/$defs/discrepancy"}}
      }
    }
  }
}
