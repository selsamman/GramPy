#!/usr/bin/env python3
"""Verify the installed external-data release against its committed inventory."""
import argparse
import json
import os
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from grampy.sidecar import verify


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(os.environ.get("GRAMPY_TEST_SAMPLES", ROOT / "tests/samples")))
    parser.add_argument("--manifest", type=Path, default=ROOT / "tests/fixtures/sidecar-v1.json")
    parser.add_argument("--include-history", action="store_true", help="also require and verify the optional archive")
    args = parser.parse_args()
    try:
        manifest = json.loads(args.manifest.read_text())
        if manifest["schema"] != "grampy-sidecar-inventory.v1":
            raise ValueError("Unsupported inventory schema")
        checked, failures = verify(args.root, manifest, include_history=args.include_history)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"Sidecar inventory error: {error}", file=sys.stderr)
        return 2
    for failure in failures:
        print(failure, file=sys.stderr)
    print(f"Verified {checked} files; {len(failures)} failures; optional archive {'included' if args.include_history else 'excluded'}.")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
