#!/usr/bin/env python3
from __future__ import annotations

import argparse
import html
import json
from pathlib import Path
import shutil


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Publish a portable MFSK picture review package."
    )
    parser.add_argument("--corpus", required=True, type=Path)
    parser.add_argument("--direct-root", type=Path)
    parser.add_argument("--fldigi-root", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--summary", type=Path)
    parser.add_argument("--gate", type=Path)
    parser.add_argument("--title", default="MFSK image review")
    parser.add_argument("--direct-label", default="Direct decoder")
    parser.add_argument("--fldigi-label", default="Qualified recent fldigi")
    parser.add_argument("--decision-status", default="evaluation")
    parser.add_argument("--baseline-root", type=Path)
    parser.add_argument("--baseline-label", default="Accepted production baseline")
    parser.add_argument(
        "--candidate", action="append", default=[], metavar="LABEL=ROOT",
        help="Named candidate score root; repeat for every surviving candidate.",
    )
    return parser.parse_args()


def copy_image(source: Path | None, destination: Path) -> str | None:
    if source is None or not source.is_file():
        return None
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    return str(destination)


def decoded_source(item: dict, corpus: Path) -> Path | None:
    artifact = item.get("decoded_artifact")
    if not artifact:
        return None
    path = Path(artifact)
    if path.is_file():
        return path
    if str(path).startswith(".local/session"):
        archived = Path(".local/archive/sessions") / Path(str(path).removeprefix(".local/"))
        if archived.is_file():
            return archived
    candidate = corpus / path
    return candidate if candidate.is_file() else None


def candidate_specs(values: list[str]) -> list[tuple[str, Path]]:
    result = []
    for value in values:
        label, separator, root = value.partition("=")
        if not separator or not label or not root:
            raise ValueError("--candidate must be LABEL=ROOT")
        result.append((label, Path(root)))
    return result


def candidate_review(args: argparse.Namespace) -> int:
    if args.baseline_root is None or not args.candidate:
        raise ValueError("candidate review requires --baseline-root and --candidate")
    candidates = candidate_specs(args.candidate)
    args.output.mkdir(parents=True, exist_ok=True)
    assets = args.output / "assets"
    rows = []
    for baseline_path in sorted(args.baseline_root.glob("*-score.json")):
        baseline = json.loads(baseline_path.read_text())
        transmission = baseline["transmission_id"]
        program_id = baseline["program_id"]
        program_root = args.corpus / "programs" / program_id
        program = json.loads((program_root / "program.json").read_text())
        fldigi = json.loads((args.fldigi_root / f"{transmission}-score.json").read_text())
        baseline_by_order = {item["order"]: item for item in baseline["pictures"]}
        fldigi_by_order = {item["order"]: item for item in fldigi["pictures"]}
        candidate_by_label = {}
        for label, root in candidates:
            score = json.loads((root / f"{transmission}-score.json").read_text())
            candidate_by_label[label] = {item["order"]: item for item in score["pictures"]}
        for expected in program["pictures"]:
            order = expected["order"]
            prefix = Path(program_id) / transmission / f"{order:03d}"
            sources = [("Truth/reference", program_root / expected["artifact"]["path"] if expected.get("artifact") else None),
                       (args.baseline_label, decoded_source(baseline_by_order[order], args.corpus))]
            sources += [(label, decoded_source(items[order], args.corpus)) for label, items in candidate_by_label.items()]
            sources.append((args.fldigi_label, decoded_source(fldigi_by_order[order], args.corpus)))
            cells = []
            for index, (label, source) in enumerate(sources):
                copied = copy_image(source, assets / prefix / f"{index:02d}.png")
                relative = str(Path(copied).relative_to(args.output)) if copied else None
                body = f'<img src="{html.escape(relative)}" alt="{html.escape(label)}">' if relative else '<div class="missing">Unavailable</div>'
                cells.append(f"<figure><figcaption>{html.escape(label)}</figcaption>{body}</figure>")
            rows.append(f'<section><h2>Program {program_id} · {transmission} · #{order} {html.escape(expected["stable_id"])}</h2><div class="images">{"".join(cells)}</div></section>')
    document = ('<!doctype html><meta charset="utf-8">' f'<title>{html.escape(args.title)}</title>'
                '<style>body{font:15px system-ui;margin:2rem;background:#f5f5f5;color:#222}section{background:white;padding:1rem;margin:1rem 0;border:1px solid #ccc}.images{display:grid;grid-template-columns:repeat(' + str(3 + len(candidates)) + ',minmax(220px,1fr));gap:1rem}figure{margin:0}figcaption{font-weight:700;margin-bottom:.5rem}img{max-width:100%;border:1px solid #999}.missing{min-height:10rem;display:grid;place-items:center;background:#eee;color:#666}</style>'
                f'<h1>{html.escape(args.title)}</h1><p>Truth · accepted baseline · candidates · pinned reference</p>' + "\n".join(rows))
    (args.output / "index.html").write_text(document, encoding="utf-8")
    print(f"wrote {args.output / 'index.html'}")
    return 0


def metric(item: dict) -> str:
    score = item.get("pixel_score", {})
    status = score.get(
        "status",
        "scored" if "aligned_mean_absolute_error_255" in score else "unknown",
    )
    parts = [status]
    aligned_mae = score.get("aligned_mean_absolute_error_255")
    if aligned_mae is not None:
        parts.append(f"aligned MAE {aligned_mae:.4f}/255")
    raw_mae = score.get("raw_mean_absolute_error_255")
    if raw_mae is not None:
        parts.append(f"raw MAE {raw_mae:.4f}/255")
    maximum_offset = score.get("maximum_absolute_offset_components")
    if maximum_offset is not None:
        parts.append(f"maximum alignment {maximum_offset} components")
    runs = score.get("offset_path_rle", [])
    if runs:
        dominant = max(
            runs,
            key=lambda run: run["stop_component"] - run["start_component"],
        )
        parts.append(f"dominant alignment {dominant['offset']:+d} components")
    return "; ".join(parts)


def anomaly(item: dict) -> str:
    if item.get("event_status") != "detected":
        return "Picture not recovered."
    notes = []
    if not item.get("geometry_matches", False):
        notes.append("geometry mismatch")
    score = item.get("pixel_score", {})
    mae = score.get("aligned_mean_absolute_error_255")
    if mae is not None and mae >= 40:
        notes.append("large visible raster error expected from numeric MAE")
    if score.get("maximum_absolute_offset_components", 0):
        notes.append(f"alignment offset reaches {score['maximum_absolute_offset_components']} components")
    return "; ".join(notes) if notes else "No anomaly inferred from event/geometry/raw score; inspect visually."


def final_scorecard(args: argparse.Namespace) -> dict | None:
    if (args.summary is None) != (args.gate is None):
        raise ValueError("--summary and --gate must be supplied together")
    if args.summary is None:
        return None
    summary = json.loads(args.summary.read_text(encoding="utf-8"))
    gate = json.loads(args.gate.read_text(encoding="utf-8"))
    identities = gate["identities"]
    by_decoder = {
        item["decoder"]: item for item in summary["decoder_summaries"]
    }
    direct = by_decoder[identities["direct_decoder"]["name"]]
    fldigi = by_decoder[identities["fldigi"]["name"]]
    metrics = {
        "text_character_error_rate": {
            "direct": direct["text_character_error_rate"],
            "fldigi": fldigi["text_character_error_rate"],
            "direct_minus_fldigi": (
                direct["text_character_error_rate"]
                - fldigi["text_character_error_rate"]
            ),
            "direction": "lower_is_better",
        },
        "picture_event_recall": {
            "direct": direct["picture_event_recall"],
            "fldigi": fldigi["picture_event_recall"],
            "direct_minus_fldigi": (
                direct["picture_event_recall"]
                - fldigi["picture_event_recall"]
            ),
            "direction": "higher_is_better",
        },
        "aligned_image_mae_255": {
            "direct": direct["aligned_image_mae_255"],
            "fldigi": fldigi["aligned_image_mae_255"],
            "direct_minus_fldigi": (
                direct["aligned_image_mae_255"]
                - fldigi["aligned_image_mae_255"]
            ),
            "direction": "lower_is_better",
        },
    }
    for key in (
        "raw_image_mae_255",
        "maximum_absolute_alignment_offset_components",
        "maximum_absolute_dominant_alignment_offset_components",
    ):
        if direct.get(key) is None or fldigi.get(key) is None:
            continue
        metrics[key] = {
            "direct": direct[key],
            "fldigi": fldigi[key],
            "direct_minus_fldigi": direct[key] - fldigi[key],
            "direction": "lower_is_better",
        }
    catastrophic_by_metric: dict[str, int] = {}
    for item in gate["catastrophic_regressions"]:
        metric = item["metric"]
        catastrophic_by_metric[metric] = catastrophic_by_metric.get(metric, 0) + 1
    return {
        "schema": "grampy-final-scorecard.v1",
        "decision_status": args.decision_status,
        "title": args.title,
        "labels": {
            "direct": args.direct_label,
            "fldigi": args.fldigi_label,
        },
        "identities": identities,
        "aggregation": direct["aggregation"],
        "program_count": direct["program_count"],
        "metrics": metrics,
        "planning_gate": {
            "policy_id": gate["policy_id"],
            "passed": gate["passed"],
            "aggregate_weighted_advantage": gate[
                "aggregate_weighted_advantage"
            ],
            "catastrophic_regressions_by_metric": catastrophic_by_metric,
            "picture_fidelity_catastrophic_regression_count": (
                catastrophic_by_metric.get("pixel_fidelity", 0)
            ),
        },
        "cases": gate["cases"],
    }


def scorecard_html(scorecard: dict | None) -> str:
    if scorecard is None:
        return ""
    labels = scorecard["labels"]
    metrics = scorecard["metrics"]
    rows = []
    definitions = (
        ("Text CER", "text_character_error_rate", "percent"),
        ("Picture recall", "picture_event_recall", "percent"),
        ("Aligned image MAE /255", "aligned_image_mae_255", "number"),
        ("Raw image MAE /255", "raw_image_mae_255", "number"),
        (
            "Maximum alignment compensation (components)",
            "maximum_absolute_alignment_offset_components",
            "number",
        ),
        (
            "Maximum dominant alignment compensation (components)",
            "maximum_absolute_dominant_alignment_offset_components",
            "number",
        ),
    )
    for label, key, kind in definitions:
        if key not in metrics:
            continue
        item = metrics[key]
        if kind == "percent":
            direct = f"{100 * item['direct']:.4f}%"
            fldigi = f"{100 * item['fldigi']:.4f}%"
            delta = f"{100 * item['direct_minus_fldigi']:+.4f} pp"
        else:
            direct = f"{item['direct']:.4f}"
            fldigi = f"{item['fldigi']:.4f}"
            delta = f"{item['direct_minus_fldigi']:+.4f}"
        rows.append(
            f"<tr><th>{html.escape(label)}</th><td>{direct}</td>"
            f"<td>{fldigi}</td><td>{delta}</td></tr>"
        )
    gate = scorecard["planning_gate"]
    picture_regressions = gate["picture_fidelity_catastrophic_regression_count"]
    return (
        '<section class="scorecard"><h2>Final scorecard</h2>'
        f'<p><b>Status:</b> {html.escape(scorecard["decision_status"])} · '
        f'<b>Aggregation:</b> {html.escape(scorecard["aggregation"])} · '
        f'<b>Programs:</b> {scorecard["program_count"]}</p>'
        '<table><thead><tr><th>Metric</th>'
        f'<th>{html.escape(labels["direct"])}</th>'
        f'<th>{html.escape(labels["fldigi"])}</th>'
        '<th>Direct − fldigi</th></tr></thead><tbody>'
        + "".join(rows)
        + "</tbody></table>"
        f'<p><b>Policy weighted advantage:</b> '
        f'{gate["aggregate_weighted_advantage"]:+.5f} · '
        f'<b>Picture-fidelity catastrophic regressions:</b> '
        f'{picture_regressions}. The complete gate remains '
        f'{"passed" if gate["passed"] else "not passed"}; see '
        '<code>scorecard.json</code> for the per-case and identity evidence.'
        "</p></section>"
    )


def main() -> int:
    args = arguments()
    if args.baseline_root is not None or args.candidate:
        return candidate_review(args)
    if args.direct_root is None:
        raise ValueError("legacy review requires --direct-root")
    args.output.mkdir(parents=True, exist_ok=True)
    assets = args.output / "assets"
    rows = []
    scorecard = final_scorecard(args)
    manifest = {
        "schema": "grampy-image-review.v1",
        "title": args.title,
        "labels": {
            "direct": args.direct_label,
            "fldigi": args.fldigi_label,
        },
        "scorecard": "scorecard.json" if scorecard is not None else None,
        "programs": [],
    }
    for direct_path in sorted(args.direct_root.glob("*-score.json")):
        direct = json.loads(direct_path.read_text())
        transmission = direct["transmission_id"]
        fldigi_path = args.fldigi_root / f"{transmission}-score.json"
        if not fldigi_path.is_file():
            raise FileNotFoundError(f"missing recent fldigi scorecard: {fldigi_path}")
        fldigi = json.loads(fldigi_path.read_text())
        program_id = direct["program_id"]
        program_root = args.corpus / "programs" / program_id
        program = json.loads((program_root / "program.json").read_text())
        by_order_direct = {item["order"]: item for item in direct["pictures"]}
        by_order_fldigi = {item["order"]: item for item in fldigi["pictures"]}
        transmission_record = {"program_id": program_id, "transmission_id": transmission, "pictures": []}
        for expected in program["pictures"]:
            order = expected["order"]
            d = by_order_direct[order]
            f = by_order_fldigi[order]
            prefix = Path(program_id) / transmission / f"{order:03d}"
            truth_source = program_root / expected["artifact"]["path"] if expected.get("artifact") else None
            direct_source = Path(d["decoded_artifact"]) if d.get("decoded_artifact") else None
            fldigi_source = args.corpus / f["decoded_artifact"] if f.get("decoded_artifact") else None
            copied = {
                "truth": copy_image(truth_source, assets / prefix / "truth.png"),
                "direct": copy_image(direct_source, assets / prefix / "direct.png"),
                "fldigi": copy_image(fldigi_source, assets / prefix / "fldigi.png"),
            }
            copied = {name: (str(Path(path).relative_to(args.output)) if path else None) for name, path in copied.items()}
            record = {
                "order": order, "stable_id": expected["stable_id"],
                "expected_header": expected["expected_header"],
                "geometry": [expected["width"], expected["height"]],
                "truth_status": expected["pixel_truth_status"],
                "direct_status": d.get("event_status"), "direct_metric": metric(d),
                "fldigi_status": f.get("event_status"), "fldigi_metric": metric(f),
                "direct_anomaly": anomaly(d), "fldigi_anomaly": anomaly(f),
                "assets": copied,
            }
            transmission_record["pictures"].append(record)
            cells = []
            for label, key in (
                ("Truth/reference", "truth"),
                (args.direct_label, "direct"),
                (args.fldigi_label, "fldigi"),
            ):
                body = f'<img src="{html.escape(copied[key])}" alt="{label}">' if copied[key] else '<div class="missing">Unavailable</div>'
                cells.append(f"<figure><figcaption>{label}</figcaption>{body}</figure>")
            rows.append(f'<section><h2>Program {program_id} · {transmission} · #{order} {html.escape(expected["stable_id"])}</h2><p><b>Header:</b> {html.escape(expected["expected_header"])} · <b>Geometry:</b> {expected["width"]}×{expected["height"]} · <b>Truth:</b> {html.escape(expected["pixel_truth_status"])}</p><div class="images">{"".join(cells)}</div><p><b>Direct:</b> {html.escape(metric(d))}; {html.escape(anomaly(d))}<br><b>Fldigi:</b> {html.escape(metric(f))}; {html.escape(anomaly(f))}</p></section>')
        manifest["programs"].append(transmission_record)
    (args.output / "manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    if scorecard is not None:
        (args.output / "scorecard.json").write_text(
            json.dumps(scorecard, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
    document = (
        '<!doctype html><meta charset="utf-8">'
        f'<title>{html.escape(args.title)}</title>'
        '<style>body{font:15px system-ui;margin:2rem;background:#f5f5f5;'
        'color:#222}section{background:white;padding:1rem;margin:1rem 0;'
        'border:1px solid #ccc}.images{display:grid;grid-template-columns:'
        'repeat(3,1fr);gap:1rem}figure{margin:0}figcaption{font-weight:700;'
        'margin-bottom:.5rem}img{max-width:100%;image-rendering:auto;'
        'border:1px solid #999}.missing{min-height:10rem;display:grid;'
        'place-items:center;background:#eee;color:#666}table{border-collapse:'
        'collapse}th,td{padding:.45rem .7rem;border:1px solid #bbb;'
        'text-align:right}th:first-child{text-align:left}</style>'
        f'<h1>{html.escape(args.title)}</h1>'
        '<p>Visual inspection supplements raw raster scoring; it does not '
        'replace it.</p>'
        + scorecard_html(scorecard)
        + "\n".join(rows)
        + "\n"
    )
    (args.output / "index.html").write_text(document, encoding="utf-8")
    print(f"wrote {args.output / 'index.html'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
